# ==============================================================================
# YouGile AI Agent — шаблон переменных окружения
#
# Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env в git НЕ коммитится (см. .gitignore).
# На Render эти же значения задаются в Settings → Environment.
# ==============================================================================


# ------------------------------------------------------------------------------
# ОБЯЗАТЕЛЬНЫЕ — без них приложение работает в ограниченном режиме
# ------------------------------------------------------------------------------

# MongoDB (Atlas или своя). Используется для результатов, кэша поиска,
# дедупликации вебхуков, блокировок задач и whitelist'а Telegram-бота.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_DB=ai_tasks

# Z.AI (GLM). Ключ создаётся на https://z.ai — раздел API Keys
ZAI_API_KEY=

# YouGile. Профиль → API-ключи.
# Исторически в проекте встречались два имени; поддерживаются оба,
# приоритет у YOUGILE_API_KEY. Достаточно задать одно.
YOUGILE_API_KEY=
# YOUGILE_GLM_API_KEY=

# Токен для служебных HTTP-эндпоинтов (/stats, /columns, /assistant, /runs и т.д.).
# Придумайте длинную случайную строку. Без неё эндпоинты ОТКРЫТЫ НЕ БУДУТ (503).
# Передавать в заголовке: X-Admin-Token: <значение>
ADMIN_TOKEN=


# ------------------------------------------------------------------------------
# YOU GILE — ID колонок доски
# ------------------------------------------------------------------------------
# Узнать ID: GET /columns с заголовком X-Admin-Token, либо в URL колонки в вебе.

COLUMN_TO_EXECUTE=            # «К выполнению» — отсюда агент забирает задачи
COLUMN_EXECUTING=             # «Выполняется»
COLUMN_DONE=                  # «Готово»
COLUMN_ERROR=                 # «Ошибка»
COLUMN_AWAITING_CONFIRMATION= # «Ждут подтверждения» — сюда попадают задачи из писем
COLUMN_DEFAULT=               # колонка по умолчанию для задач из Telegram

# ID пользователя YouGile, на которого назначаются задачи агента
YOUGILE_GLM_USER_ID=

# Параметр постраничного обхода в GET /tasks. YouGile валидирует query-параметры
# по схеме и отвергает неизвестные (400 "property page should not exist").
# Значение определяется автоматически: при первом же отказе пагинация отключается,
# а в лог пишется подсказка. Варианты: offset, skip, from, page.
# Пустое значение или "none" — отключить пагинацию явно.
YOUGILE_PAGE_PARAM=offset
YOUGILE_PAGE_SIZE=50

# Метка (стикер) для задач, созданных агентом
AI_STICKER_ID=c553a657-fa54-4532-9d02-4750e013005f


# ------------------------------------------------------------------------------
# TELEGRAM
# ------------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WHITELIST: chat ID администраторов через запятую.
# Как только переменная задана, бот перестаёт принимать команды от посторонних.
# Админы из этого списка неотзываемы командой /deny — это защита от блокировки
# самого себя. Остальных можно добавлять прямо в боте: /allow <chatId>, /who.
#
# Если переменная ПУСТА и список доступа в базе пуст — бот работает в открытом
# режиме (и предупреждает об этом в логах и в чате). Сделано специально, чтобы
# нельзя было потерять доступ сразу после деплоя.
TELEGRAM_ADMIN_IDS=


# ------------------------------------------------------------------------------
# ПОЧТА (IMAP) — приём задач
# ------------------------------------------------------------------------------

MAIL_USER=ai@example.com
MAIL_PASSWORD=            # app-пароль, НЕ основной пароль от ящика
MAIL_HOST=mail.fl.h12.ose.su
MAIL_PORT=993
MAIL_INBOX=INBOX
MAIL_DONE_FOLDER=AI_DONE  # сюда переносятся обработанные письма (создаётся сама)
MAIL_POLL_INTERVAL_MS=120000

# Маркеры темы письма-задачи, через запятую.
# Письмо берётся в работу, если тема содержит любой из маркеров (регистр не важен).
MAIL_TASK_SUBJECT_MARKERS=[TASK]

# Имя для проверки TLS-сертификата, если оно отличается от MAIL_HOST.
# Нужно, когда почтовый сервер отдаёт сертификат на родительский домен.
# Реальный пример: подключение к mail.fl.h12.ose.su, а в сертификате только DNS:h12.ose.su
# → без этой переменной Node отклоняет соединение с ошибкой
#   "Hostname/IP does not match certificate's altnames".
# Проверка цепочки сертификатов при этом остаётся ВКЛЮЧЁННОЙ — это безопасно.
MAIL_TLS_SERVERNAME=h12.ose.su

# Крайний случай: полное отключение проверки сертификата. Держите false.
MAIL_TLS_INSECURE=false

# Максимальная пауза между повторами IMAP IDLE при сбоях подключения (мс).
# Без ограничения повторов лог забивается одинаковыми ошибками каждые 5 секунд.
MAIL_IDLE_RETRY_MAX_MS=300000


# ------------------------------------------------------------------------------
# AI / GLM
# ------------------------------------------------------------------------------

GLM_MODEL=glm-4.5-flash
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_TIMEOUT_MS=120000
GLM_MAX_STEPS=25            # лимит шагов агента на задачу
GLM_MAX_STEPS_QUESTION=6    # лимит шагов при ответе на вопрос в чате
GLM_MAX_RETRIES=4           # повторы при 429/5xx
GLM_MAX_CONTEXT_CHARS=90000 # бюджет контекста; старше него история обрезается


# ------------------------------------------------------------------------------
# ВЕБ-ПОИСК
# ------------------------------------------------------------------------------

# Tavily: https://app.tavily.com — 1000 запросов/месяц бесплатно
TAVILY_API_KEY=

SEARCH_MAX_RESULTS=8
SEARCH_TIMEOUT_MS=25000


# ------------------------------------------------------------------------------
# ОБЛАЧНОЕ ХРАНИЛИЩЕ ДОКУМЕНТОВ
# ------------------------------------------------------------------------------

# mongo | r2 | pcloud | none | auto
#   mongo  — документы лежат в вашей MongoDB и раздаются через подписанные
#            ссылки /files/... Не требует ВНЕШНИХ АККАУНТОВ И ПЛАТЁЖНЫХ КАРТ:
#            база и так обязательна для агента. Бесплатный тариф Atlas — 512 МБ,
#            этого хватает на тысячи документов.
#   r2     — Cloudflare R2: 10 ГБ бесплатно, ссылки с CDN. Требует активации
#            подписки, а Cloudflare просит платёжную карту.
#   pcloud — работает только с OAuth2-токеном от поддержки pCloud.
#   auto (по умолчанию) = r2, если настроен; иначе pcloud; иначе mongo; иначе отключено.
# Весь остальной код работает через lib/cloud.js, поэтому смена хранилища —
# это одна переменная, а не правка исходников.
CLOUD_PROVIDER=mongo

# --- Cloudflare R2 (РЕКОМЕНДУЕТСЯ) --------------------------------------------
# 10 ГБ бесплатно, исходящий трафик бесплатный, токен создаётся в дашборде
# за минуту без писем в поддержку. Ссылки раздаёт CDN Cloudflare, а не спящий
# dyno Render — документ открывается мгновенно.
#
# Где взять значения:
#   R2_ACCOUNT_ID         → R2 → правая колонка «Account details» → Account ID
#   R2_ACCESS_KEY_ID      → R2 → Account details → Manage API Tokens → Create API token
#   R2_SECRET_ACCESS_KEY  → там же, показывается ОДИН раз после создания
#   R2_BUCKET             → имя бакета, который вы создали
#   R2_PUBLIC_BASE_URL    → Settings бакета → Custom Domain или Public Development URL

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Публичный адрес бакета — например https://files.example.com или https://pub-XXXX.r2.dev
# Если задать: ссылки будут прямыми на CDN Cloudflare.
# Если НЕ задавать: файлы раздаются через наш сервер по адресу /files/<подпись>,
# а бакет остаётся приватным (для бизнес-документов это предпочтительнее).
R2_PUBLIC_BASE_URL=

# Юрисдикция бакета: пусто (default), eu, us или fedramp.
# Влияет на хост API: https://<ACCOUNT_ID>.<юрисдикция>.r2.cloudflarestorage.com
R2_JURISDICTION=

# Префикс (папка) внутри бакета для документов агента
R2_PREFIX=ai-documents

# Секрет для подписи ссылок /files/<подпись> (нужен только при приватном бакете).
# По умолчанию используется ADMIN_TOKEN. Ссылки не имеют срока действия —
# они попадают в комментарии задач YouGile, которые читают спустя недели.
FILES_SECRET=

# Полное переопределение хоста S3 API. Обычно не нужно: хост выводится из
# R2_ACCOUNT_ID. Переменная используется в тестах и позволяет подключиться
# к любому другому S3-совместимому хранилищу.
R2_ENDPOINT=
R2_REGION=auto
R2_TIMEOUT_MS=60000

# --- pCloud (НЕ РАБОТАЕТ без OAuth2-токена от поддержки) ----------------------
# В апреле 2026 pCloud отключил авторизацию по логину/паролю и отозвал все
# выданные ею токены. OAuth-приложение создаёт только поддержка pCloud по запросу.
# Если получите OAuth2 access_token — положите его сюда, клиент готов к работе.
# Подробности в README, раздел «Облачное хранилище».
PCLOUD_AUTH_TOKEN=
PCLOUD_REGION=eu
PCLOUD_FOLDER_ID=0
PCLOUD_FOLDER_NAME=AI-документы
PCLOUD_TIMEOUT_MS=60000

# Только для утилиты npm run pcloud:token (сейчас не работает из-за политики pCloud)
PCLOUD_EMAIL=
PCLOUD_PASSWORD=


# ------------------------------------------------------------------------------
# ИСПОЛНЕНИЕ ЗАДАЧ
# ------------------------------------------------------------------------------

TASK_POLL_INTERVAL_MS=30000  # как часто проверять колонку «К выполнению»
TASK_BATCH_SIZE=3            # сколько задач брать за один проход
TASK_RUNNING_TTL_MIN=30      # через сколько минут «зависший» запуск считается мёртвым
TASK_MAX_ATTEMPTS=3          # сколько раз повторять упавшую задачу
TASK_RETRY_COOLDOWN_MIN=5    # пауза между повторами


# ------------------------------------------------------------------------------
# HTTP-СЕРВЕР И ПРОЧЕЕ
# ------------------------------------------------------------------------------

PORT=3000                              # Render подставляет сам, локально можно не менять
PUBLIC_BASE_URL=https://yougile-glm.onrender.com  # нужен для подписки на вебхуки YouGile
HTTP_TIMEOUT_MS=30000                  # таймаут по умолчанию для всех внешних запросов

REPORT_TZ=Europe/Moscow                # часовой пояс ежедневного отчёта
REPORT_HOUR=9                          # час отправки (по REPORT_TZ)

TMP_DIR=                               # куда складывать временные файлы документов


# ------------------------------------------------------------------------------
# ОТЛАДКА
# ------------------------------------------------------------------------------

LOG_LEVEL=info

# Подавление предупреждения Node "ExperimentalWarning: localStorage is not
# available". Его печатают браузерные сборки docx/exceljs при загрузке модулей;
# на работу не влияет, но засоряет лог Render.
# NODE_OPTIONS=--disable-warning=ExperimentalWarning
