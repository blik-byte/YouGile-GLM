# Единые окончания строк для всех платформ.
# Раньше index.js был в CRLF, остальные файлы в LF — это давало шумные diff'ы
# и конфликты при правках с разных ОС.
* text=auto eol=lf

*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Бинарные файлы не нормализуем
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.docx  binary
*.zip   binary
